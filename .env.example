SERPAPI_KEY=
GEMINIAPI_KEY=
LANGSMITH_API_KEY=

# Phase 1a resilience tuning (all optional — defaults shown)
PRODUCT_CACHE_TTL_SECONDS=86400
SEARCH_CACHE_TTL_SECONDS=3600
CACHE_DB_PATH=.cache/scoutii_cache.db
RATE_LIMIT_PER_MINUTE=10
LLM_MAX_RETRIES=3

# Phase 1c cost-estimation overrides (optional — defaults are estimates at time of writing)
FLASH_COST_PER_1K_INPUT=0.0003
FLASH_COST_PER_1K_OUTPUT=0.0025
PRO_COST_PER_1K_INPUT=0.00125
PRO_COST_PER_1K_OUTPUT=0.010
SERPAPI_COST_PER_CALL=0.005
